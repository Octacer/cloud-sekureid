{
  "openapi": "3.1.0",
  "info": {
    "title": "Octacer Internal Tooling Platform",
    "description": "Octacer's internal tooling platform — a single API bundling attendance report generation, document & text extraction (OCR), image processing, audio/video transcription, and web automation.",
    "version": "1.0.0"
  },
  "paths": {
    "/generate-report": {
      "post": {
        "summary": "Generate Report",
        "description": "Generate attendance report and return JSON with download URL\n\nParameters:\n- company_code: Company code for login (default: 85)\n- username: Username for login (default: hisham.octacer)\n- password: Password for login\n- report_date: Date for report in YYYY-MM-DD format (default: today)\n\nReturns:\n- JSON with report_url (download link), file_id, and metadata",
        "operationId": "generate_report_generate_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/generate-report-direct": {
      "post": {
        "summary": "Generate Report Direct",
        "description": "Generate attendance report and directly return Excel file\n\nParameters:\n- company_code: Company code for login (default: 85)\n- username: Username for login (default: hisham.octacer)\n- password: Password for login\n- report_date: Date for report in YYYY-MM-DD format (default: today)\n\nReturns:\n- Excel file with attendance report (direct download)",
        "operationId": "generate_report_direct_generate_report_direct_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/get-report-default": {
      "get": {
        "summary": "Get Report Default",
        "description": "Generate today's report with default credentials - Returns JSON with download URL\n\nThis is a convenience endpoint that generates today's report using default credentials.\nSimply call: GET /get-report-default\n\nReturns:\n- JSON with report_url (download link), file_id, and metadata",
        "operationId": "get_report_default_get_report_default_get",
