      "post": {
        "summary": "Extract Text",
        "description": "Extract text from an image, PDF, spreadsheet, or Word document.\n\nParameters:\n- url: Publicly accessible URL to the file\n\nReturns:\n- JSON with extracted text, language detected, and extraction metadata",
