    "/resize-image": {
      "post": {
        "summary": "Resize Image",
        "description": "Resize and/or convert an image.\n\nAccepts common raster formats (PNG, JPG/JPEG, WEBP, GIF, BMP, TIFF, and\nHEIC/HEIF when pillow-heif is installed) and returns a URL to the converted\nimage.\n\nParameters:\n- url: Publicly accessible URL to the source image\n- width / height: Target dimensions in pixels (either or both, optional)\n- mode: 'fit' (keep aspect ratio within the box, default) or 'exact'\n- output_format: jpeg | jpg | png | webp (default: jpeg)\n- quality: Encoder quality 1-100 for lossy formats (default: 90)",
        "operationId": "resize_image_resize_image_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageResizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageResizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/get-vollna-cookies": {
      "get": {
        "summary": "Get Vollna Cookies",
        "description": "Get cookies from Vollna website after login\n\nParameters:\n- email: Email for login (default: mateo@brightdock.com)\n- password: Password for login (default: Antonia.12)\n- final_url: Final URL to navigate to after login (default: https://www.vollna.com/dashboard/filter/22703)\n\nReturns:\n- JSON with cookies as a string, cookie count, and extraction timestamp",
        "operationId": "get_vollna_cookies_get_vollna_cookies_get",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "mateo@brightdock.com",
              "title": "Email"
            }
          },
          {
            "name": "password",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "Antonia.12",
              "title": "Password"
            }
          },
          {
            "name": "final_url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "https://www.vollna.com/dashboard/filter/22703",
              "title": "Final Url"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VollnaCookiesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scrape-google-serp": {
      "post": {
        "summary": "Scrape Google Serp",
        "description": "Scrape Google Search Engine Results Page (SERP)\n\nReturns organic search results for a given query\n\n**Parameters:**\n- **query**: Search query string (required)\n- **num_results**: Number of results per page - must be 10, 20, 30, 50, or 100 (default: 10)\n- **page**: Page number between 1 and 10 (default: 1)\n- **language**: Language code like 'en', 'es', 'fr' (default: 'en')\n\n**Returns:**\n- JSON with organic search results including position, title, URL, and snippet\n- CAPTCHA detection will return HTTP 429 error\n\n**Note:** Web scraping Google may violate their Terms of Service.\nThis is for educational/research purposes only.",
        "operationId": "scrape_google_serp_scrape_google_serp_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSerpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoogleSerpResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transcribe": {
      "post": {
        "summary": "Transcribe",
        "description": "Transcribe an audio or video file to text using Whisper (faster-whisper).\n\nParameters:\n- **url**: Publicly accessible URL to an audio or video file\n  (mp3, wav, m4a, ogg, flac, mp4, mov, webm, ...). Audio is extracted\n  automatically from video containers.\n- **language**: ISO code like 'en', 'es', 'ar' to force a language; omit to\n  auto-detect.\n- **task**: 'transcribe' (keep original language) or 'translate' (to English).\n- **include_segments**: include per-segment timestamps (default: true).\n\nReturns:\n- JSON with the full transcript, detected language, duration, and optional\n  timestamped segments.",
        "operationId": "transcribe_transcribe_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptionRequest"
              }
            }
          },
          "required": true
